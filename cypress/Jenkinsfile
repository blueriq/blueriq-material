#!groovy

pipeline {
  agent any

  tools {
    jdk 'jdk-25'
    maven 'apache-maven-3.9'
    nodejs 'node-22.14.0'
    ant 'apache-ant-1.10'
  }

  environment {
    // pnpm runs as its native binary, fetched into PNPM_EXE_DIR by the install pnpm stage. Steps that run pnpm put
    // PNPM_EXE_DIR first on PATH with withEnv, as tools are put back in front of PATH for every stage.
    PNPM_VERSION = '12.11.2'
    PNPM_EXE_DIR = "${env.WORKSPACE}\\.pnpm-bin"
  }

  options {
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder logRotator(numToKeepStr: '5')
    disableConcurrentBuilds()
    lock('material-e2e-docker')
    ansiColor('xterm')
  }

  parameters {
    string(name: 'RUNTIME_BRANCH', defaultValue: 'master', description: "The runtime branch to test against")
  }

  stages {
    stage('install pnpm') {
      steps {
        withEnv(["PATH+PNPM=${env.PNPM_EXE_DIR}"]) {
          // npm pack fetches the package without running install scripts; Windows' bsdtar extracts pnpm.exe from it.
          bat '''
            if not exist "%PNPM_EXE_DIR%" mkdir "%PNPM_EXE_DIR%"
            call npm pack @pnpm/exe.win32-x64@%PNPM_VERSION% --pack-destination "%PNPM_EXE_DIR%" || exit /b 1
            %SystemRoot%\\System32\\tar.exe -xzf "%PNPM_EXE_DIR%\\pnpm-exe.win32-x64-%PNPM_VERSION%.tgz" -C "%PNPM_EXE_DIR%" --strip-components=1 package/pnpm.exe || exit /b 1
            call pnpm -v
          '''
        }
      }
    }

    stage('build') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'npm-readonly', usernameVariable: 'NPM_USERNAME', passwordVariable: 'NPM_PASSWORD')]) {
          bat "ant -f scripts/docker/build.xml build " +
            "-Ddocker.host=bq-build-lin.blueriq.local " +
            "-Dcommit=${env.GIT_COMMIT} " +
            "-DisRelease=false"
        }
      }
    }

    stage('cypress image') {
      steps {
        withCredentials([file(credentialsId: 'npmrc_file', variable: 'npmrc_file'),
                         usernamePassword(credentialsId: 'npm-readonly', usernameVariable: 'NPM_USERNAME', passwordVariable: 'NPM_PASSWORD')]) {
          bat "ant -f scripts/docker/e2e.xml create-build-image " +
            "-Ddocker.host=bq-docker-lin.blueriq.local " +
            "-Dcommit=${env.GIT_COMMIT} " +
            "-DnpmrcFileLocation=${npmrc_file}"
        }
      }
    }

    stage('docker prepare') {
      steps {
        withCredentials([file(credentialsId: 'BLUERIQ_RUNTIME_LICENSE', variable: 'license_file')]) {
          writeFile file: './cypress/docker/config/license.aql', text: readFile(license_file)
          writeFile file: './cypress/docker/dashboards/config/runtime/license.aql', text: readFile(license_file)
          writeFile file: './cypress/docker/dashboards/config/case-engine/license.aql', text: readFile(license_file)
        }
        withEnv(["PATH+PNPM=${env.PNPM_EXE_DIR}"]) {
          bat "pnpm run e2e:docker-prepare -skipCompose -runtimeBranch ${params.RUNTIME_BRANCH} -runtimeUrl ${env.RUNTIME_GIT_URL}"
          bat "pnpm run e2e:docker-prepare-dashboards -keepPreparations -skipCompose -runtimeBranch ${params.RUNTIME_BRANCH} -runtimeUrl ${env.RUNTIME_GIT_URL}"
        }
      }
    }

    stage('e2e suites') {
      failFast false
      parallel {
        stage('e2e') {
          environment {
            COMPOSE_PROJECT_NAME = 'material-e2e-cypress'
          }
          stages {
            stage('docker up') {
              steps {
                withEnv(["PATH+PNPM=${env.PNPM_EXE_DIR}"]) {
                  bat "pnpm run e2e:docker-prepare -composeOnly -inNetwork -runtimeBranch ${params.RUNTIME_BRANCH}"
                }
              }
            }

            stage('e2e tests') {
              steps {
                bat "ant -f scripts/docker/e2e.xml run " +
                  "-Ddocker.host=bq-docker-lin.blueriq.local " +
                  "-Dcommit=${env.GIT_COMMIT}"
              }
            }
          }
          post {
            always {
              withEnv(["PATH+PNPM=${env.PNPM_EXE_DIR}"]) {
                bat 'pnpm run e2e:docker-down'
              }
            }
          }
        }

        stage('e2e dashboards') {
          environment {
            COMPOSE_PROJECT_NAME = 'material-e2e-cypress-dashboards'
          }
          stages {
            stage('docker up dashboards') {
              steps {
                withEnv(["PATH+PNPM=${env.PNPM_EXE_DIR}"]) {
                  bat "pnpm run e2e:docker-prepare-dashboards -composeOnly -inNetwork -runtimeBranch ${params.RUNTIME_BRANCH}"
                }
              }
            }

            stage('e2e tests dashboards') {
              steps {
                bat "ant -f scripts/docker/e2e.xml run-e2e-dashboards " +
                  "-Ddocker.host=bq-docker-lin.blueriq.local " +
                  "-Dcommit=${env.GIT_COMMIT}"
              }
            }
          }
          post {
            always {
              withEnv(["PATH+PNPM=${env.PNPM_EXE_DIR}"]) {
                bat 'pnpm run e2e:docker-down-dashboards'
              }
            }
          }
        }
      }
    }
  }

  post {
    always {
      publishHTML([allowMissing         : true,
                   alwaysLinkToLastBuild: false,
                   keepAll              : true,
                   reportDir            : 'tmp/e2e/cypress/report/mochareports',
                   reportFiles          : 'report.html',
                   reportName           : 'Cypress e2e report',
                   reportTitles         : 'Cypress e2e report'])
      publishHTML([allowMissing         : true,
                   alwaysLinkToLastBuild: false,
                   keepAll              : true,
                   reportDir            : 'tmp/e2e-dashboards/cypress/report/mochareports',
                   reportFiles          : 'report.html',
                   reportName           : 'Cypress e2e dashboards report',
                   reportTitles         : 'Cypress e2e dashboards report'])

      // archive integration outputs
      archiveArtifacts artifacts: 'tmp/*/cypress/videos/**/*, tmp/*/cypress/screenshots/**/*, tmp/*/cypress/snapshots/**/*.diff.png, tmp/e2e-logs.txt, tmp/e2e-dashboards-logs.txt, tmp/*/cypress-visual-screenshots/diff/*, tmp/*/cypress-visual-screenshots/comparison/*',
        allowEmptyArchive: true

      notifyBuildStatus()
    }

    cleanup {
      bat returnStatus: true, script: "ant -f scripts/docker/e2e.xml cleanup-build-image -Ddocker.host=bq-docker-lin.blueriq.local -Dcommit=${env.GIT_COMMIT}"
      deleteDir()
    }
  }
}

def notifyBuildStatus() {
  // notify the person who started the build and the persons who's commits broke the build
  step([$class                  : 'Mailer',
        notifyEveryUnstableBuild: true,
        sendToIndividuals       : false,
        recipients              : emailextrecipients([culprits(), requestor()]) + " ${DEVELOPERS_EMAIL}"
  ])
}
